# PIC-SURE AI Service environment. The installer renders every
# placeholder in the external DOCKER_CONFIG_DIR copy.

PICSURE_GATEWAY_URL=http://gateway:8080

# Shared with gateway.env. Sent on every /mcp call, so the gateway admits the assistant by ASSISTED_SEARCH.
AI_SERVICE_TOKEN=__AI_SERVICE_TOKEN__

# AI_ENABLED=true
AI_MCP_MODE=gateway
AI_MODEL_PROVIDER=aws-sdk

BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_SOCKET_TIMEOUT=120s

# LOGGING_LEVEL_EDU_HARVARD_HMS_DBMI_AVILLACH_AI_CHAT=DEBUG
# LOGGING_LEVEL_SOFTWARE_AMAZON_AWSSDK_REQUEST=DEBUG
# LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_AI_BEDROCK=DEBUG
# SPRING_AI_BEDROCK_CONVERSE_CHAT_OPTIONS_TEMPERATURE=0