# Included to provide an example of the data-dictionary .env file
# A new .env will be generated as part of the install-dependencies-docker.sh.
POSTGRES_HOST=dictionary-db
POSTGRES_DB=dictionary
POSTGRES_USER=picsure
POSTGRES_PASSWORD=changeme

# Actuator: off by default in application.properties; enable a shallow /actuator/health here for the
# gateway /system/status probe and the deploy healthcheck. Details stay hidden (default never).
PICSURE_ACTUATOR_EXPOSURE=health