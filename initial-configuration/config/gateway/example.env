# PIC-SURE Gateway environment (copied/generated to
# $DOCKER_CONFIG_DIR/gateway/gateway.env by the "PIC-SURE Gateway Build and
# Deploy" Jenkins job on first run). Values here are EXAMPLES for a local
# all-in-one; the deployed gateway.env holds the real secrets and is NOT
# committed. Env vars set here override application.yml defaults.

# Spring profile: aio (default) or local.
SPRING_PROFILE=aio

# ---- Gateway auth + audit ------------------------------------------
# The gateway is the auth boundary and always enforces it: every route is introspected
# and audited. There is no transparent/pass-through mode and no opt-out switch.

# PSAMA token introspection. URLs are the AIO service DNS; the token is the
# PSAMA_APPLICATION service JWT (SECRET).
TOKEN_INTROSPECTION_URL=http://psama:8090/auth/token/inspect
OPEN_ACCESS_VALIDATE_URL=http://psama:8090/auth/open/validate
TOKEN_INTROSPECTION_TOKEN=REPLACE_WITH_PSAMA_APPLICATION_SERVICE_TOKEN

# Open-access policy (AIO default: disabled).
GATEWAY_OPEN_ACCESS_ENABLED=false

# Largest request body the auth chain will buffer for consent/body mutation (default 10 MiB).
# GATEWAY_AUTH_MAX_BODY_BYTES=10485760

# Audit logging (consumed directly by the logging-client via env; the API key is a SECRET).
LOGGING_SERVICE_URL=http://pic-sure-logging
LOGGING_API_KEY=REPLACE_WITH_LOGGING_API_KEY

# ---- Actuator (off by default in application.yml; enabled here for AIO) ------
# The gateway's /actuator/** is dark unless PICSURE_ACTUATOR_EXPOSURE is set -- the default 'none'
# is a sentinel that matches no endpoint. Enable health+info: health powers the Jenkins deploy
# liveness probe (/actuator/health/liveness) and the gateway's own downstream health aggregation.
# Detail is gated: DETAILS=when_authorized only reveals component detail to a caller presenting the
# X-Application-Token. The public /system/status RUNNING/DEGRADED check is a RouterFunction, not an
# actuator endpoint, and is unaffected by these vars. Add prometheus,metrics here when the
# monitoring rollout lands -- no code change needed.
PICSURE_ACTUATOR_EXPOSURE=health,info
PICSURE_ACTUATOR_DETAILS=when_authorized
# Set false only for local debugging: it drops the X-Application-Token gate on /actuator/**.
# PICSURE_ACTUATOR_REQUIRE_TOKEN=true
# Shared secret for that gate (SECRET). Blank => every protected actuator endpoint 401s;
# shallow health/liveness/readiness stay open regardless.
PICSURE_APPLICATION_TOKEN=REPLACE_WITH_APPLICATION_TOKEN

# ---- Downstream services -------------------------------------------
# Shared secret the gateway presents as X-PIC-SURE-INTERNAL-TOKEN when it calls operations-service
# /operations/internal/** (query dispatch for result/signed-url auth). Must be byte-identical here,
# in query.env, and in operations.env. install-dependencies-docker.sh generates the value into those
# two files; copy it from $DOCKER_CONFIG_DIR/operations/operations.env (SECRET).
QUERY_SERVICE_INTERNAL_TOKEN=REPLACE_WITH_QUERY_SERVICE_INTERNAL_TOKEN

# Routing + deep-health targets. All default to the AIO service DNS in application.yml /
# application-aio.yml; uncomment only to point somewhere else.
# HPDS_QUERY_SERVICE_URL=http://pic-sure-hpds-query-service:8080
# OPERATIONS_SERVICE_URL=http://pic-sure-operations-service:8080
# LOGGING_URL=http://pic-sure-logging
# LOGGING_HEALTH_URL=http://pic-sure-logging
# DICTIONARY_URL=http://dictionary-api
# UPLOADER_URL=http://uploader:8080
# VISUALIZATION_URL=http://visualization
# PSAMA_URL=http://psama:8090
# HPDS_URL=http://hpds:8080
