# PIC-SURE Gateway environment (copied/generated to
# $DOCKER_CONFIG_DIR/gateway/gateway.env by the "PIC-SURE Gateway Build and
# Deploy" Jenkins job on first run). Values here are EXAMPLES for a local
# all-in-one; the deployed gateway.env holds the real secrets and is NOT
# committed. Env vars set here override application.yml defaults.

# ---- Phase 1: transparent catch-all -----------------------------------------
# Legacy WildFly target (Docker DNS on the picsure network).
WILDFLY_URL=http://wildfly:8080

# Spring profile: aio (default) or local.
SPRING_PROFILE=aio

# ---- Phase 2: gateway auth + audit ------------------------------------------
# MASTER SWITCH -- the gateway is the auth boundary. Default TRUE: the gateway
# introspects/audits and enforces every route. Must be set consistently with
# WildFly's java:global/gatewayOwnsAuth (standalone.xml) -- both TRUE, or every
# request is introspected AND consent-swapped twice (a double swap can corrupt
# queries). Set FALSE only to run the gateway as a pure pass-through with WildFly
# still authenticating (legacy fallback).
GATEWAY_OWNS_AUTH=true
# Explicit auth mode (transparent | enforce). enforce = full gateway enforcement on every
# route; with GATEWAY_OWNS_AUTH=true this is the resolved mode anyway -- set here for clarity.
PICSURE_GATEWAY_SECURITY_MODE=enforce

# PSAMA token introspection (the gateway's real auth boundary). URLs are the
# AIO service DNS; the token is the PSAMA_APPLICATION service JWT (SECRET --
# replace with your deployment's token; in AIO it matches WildFly's
# java:global/token_introspection_token in standalone.xml).
TOKEN_INTROSPECTION_URL=http://psama:8090/auth/token/inspect
OPEN_ACCESS_VALIDATE_URL=http://psama:8090/auth/open/validate
TOKEN_INTROSPECTION_TOKEN=REPLACE_WITH_PSAMA_APPLICATION_SERVICE_TOKEN

# Open-access policy (AIO default: disabled, matching WildFly openAccessEnabled).
GATEWAY_OPEN_ACCESS_ENABLED=false

# Audit logging (consumed directly by the logging-client via env). Point at the
# same logging service WildFly uses; the API key is a SECRET.
LOGGING_SERVICE_URL=http://pic-sure-logging
LOGGING_API_KEY=REPLACE_WITH_LOGGING_API_KEY

# ---- Phase 4: query-service dispatch for result/signed-url auth -------------
# TRUE: the gateway owns result/signed-url auth and dispatches to operations-service.
# Pair with WildFly's java:global/gatewayOwnsQueryReadAuth=true (standalone.xml).
# Requires QUERY_SERVICE_INTERNAL_TOKEN (SECRET); the dispatch URL defaults to the
# aio service DNS via application-aio.yml.
GATEWAY_OWNS_QUERY_READ_AUTH=true
# HPDS_QUERY_SERVICE_URL=
QUERY_SERVICE_INTERNAL_TOKEN=REPLACE_WITH_QUERY_SERVICE_INTERNAL_TOKEN
