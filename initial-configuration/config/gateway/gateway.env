# PIC-SURE Gateway environment. Copied to $DOCKER_CONFIG_DIR/gateway/gateway.env by
# install-dependencies-docker.sh, which substitutes the __PLACEHOLDER__ secrets below.
# The gateway build job and start-picsure.sh pass that rendered copy to --env-file.

SPRING_PROFILE=aio

# ---- Gateway auth + audit ------------------------------------------
TOKEN_INTROSPECTION_URL=http://psama:8090/auth/token/inspect
OPEN_ACCESS_VALIDATE_URL=http://psama:8090/auth/open/validate
# Rendered later by the Configure PIC-SURE Token Introspection Token Jenkins job.
TOKEN_INTROSPECTION_TOKEN=__TOKEN_INTROSPECTION_TOKEN__
GATEWAY_OPEN_ACCESS_ENABLED=false

# Audit logging.
LOGGING_SERVICE_URL=http://pic-sure-logging
LOGGING_API_KEY=__LOGGING_API_KEY__

# ---- Actuator -------------------------------------------------------
PICSURE_ACTUATOR_EXPOSURE=health,info
PICSURE_ACTUATOR_DETAILS=when_authorized
PICSURE_APPLICATION_TOKEN=__PICSURE_APPLICATION_TOKEN__

# ---- Operations-service internal API -------------------------------
# The gateway and query service present this shared secret to operations-service.
QUERY_SERVICE_INTERNAL_TOKEN=__QUERY_SERVICE_INTERNAL_TOKEN__

# ---- Rate limiting (open access) ----------------------------------
# Off by default. Limits are per minute and per UTC day; every limit must be a
# positive integer. Once RATE_LIMIT_ENABLED=true on this deployment, publish
# them on the API page by setting the frontend's branding.apiPage.rateLimits
# {perMinute, perDay} to the RATE_LIMIT_USER_* numbers; leave that key unset
# while the limiter is off.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_USER_BURST_PER_MINUTE=60
RATE_LIMIT_USER_SUSTAINED_PER_DAY=3000
RATE_LIMIT_SESSION_BURST_PER_MINUTE=60
RATE_LIMIT_SESSION_SUSTAINED_PER_DAY=3000
RATE_LIMIT_IP_BURST_PER_MINUTE=60
RATE_LIMIT_IP_SUSTAINED_PER_DAY=3000
RATE_LIMIT_IP_PREVALIDATION_PER_MINUTE=300
RATE_LIMIT_STORE_MAX_SUBJECTS=100000
# Comma-separated CIDRs of the reverse proxies in front of the gateway (httpd).
# Before enabling, set this to the subnet of httpd's network:
#   docker network inspect picsure -f '{{(index .IPAM.Config 0).Subnet}}'
# Then confirm that subnet holds the address the gateway sees. Each access-log
# line (logger gateway.access, "... peer={}") logs the TCP peer, never a header,
# as the last element of its JSON "arguments":
#   docker logs gateway 2>&1 | sed -n 's/.*"loggerName":"gateway\.access".*"arguments": *\[.*,"\([^"]*\)"\].*/\1/p' | sort | uniq -c
# The gateway refuses to start with the limiter on and this empty.
RATE_LIMIT_TRUSTED_PROXIES=
# Comma-separated source CIDRs of non-public integrations. Every open-access
# request from these sources skips the per-IP pre-validation throttle; only
# PLATFORM keys from them also skip the post-validation limits (user keys,
# sessions and other open-access traffic from them are still limited).
RATE_LIMIT_PLATFORM_ALLOWLISTED_SOURCE_CIDRS=
