# PIC-SURE MCP Service environment. The installer renders every
# placeholder in the external DOCKER_CONFIG_DIR copy.

# Loop-back calls to the gateway carry this shared secret.
PICSURE_GATEWAY_URL=http://gateway:8080
MCP_SERVICE_TOKEN=__MCP_SERVICE_TOKEN__

# How a user's adapter reaches this site, and which optional features it offers.
MCP_ADAPTER_BASE_URL=https://localhost
MCP_ADAPTER_INCLUDE_CONSENTS=false
MCP_ADAPTER_SUPPORTS_GENOMIC=false
