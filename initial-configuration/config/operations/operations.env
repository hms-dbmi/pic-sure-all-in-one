# PIC-SURE Operations Service environment. The installer renders every placeholder
# in the external DOCKER_CONFIG_DIR copy; generated values are never committed.

# The service is the sole owner of the pic-sure MySQL database.
SPRING_DATASOURCE_PASSWORD=__PICSURE_MYSQL_PASSWORD__

# Shared secret enforced on /operations/internal/**.
QUERY_SERVICE_INTERNAL_TOKEN=__QUERY_SERVICE_INTERNAL_TOKEN__

# Actuator health is required by deployment checks and gateway system status.
PICSURE_ACTUATOR_EXPOSURE=health
PICSURE_APPLICATION_TOKEN=__PICSURE_APPLICATION_TOKEN__
