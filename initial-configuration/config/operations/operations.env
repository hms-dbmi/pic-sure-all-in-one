# PIC-SURE Operations Service environment. Copied to
# $DOCKER_CONFIG_DIR/operations/operations.env by install-dependencies-docker.sh, which
# substitutes the __PLACEHOLDER__ secrets below; the "PIC-SURE Operations Service Build and
# Deploy" Jenkins job and start-picsure.sh then pass that copy straight to --env-file.
# Env vars set here override application.yml defaults.
#
# This service is the sole owner of the pic-sure MySQL database (Configuration, NamedDataset,
# Query, Site) and serves every endpoint under the /operations context-path -- so its health
# endpoint is /operations/actuator/health, NOT /actuator/health.

# ---- Datasource -----------------------------------------------------
# The URL and username already default to the AIO database in application.yml; only the
# password must be supplied. mysql-docker/setup.sh substitutes the password it assigned to
# the 'picsure' MySQL user (SECRET).
SPRING_DATASOURCE_PASSWORD=__PICSURE_MYSQL_PASSWORD__
# SPRING_DATASOURCE_URL=jdbc:mysql://picsure-db:3306/picsure?useUnicode=true&characterEncoding=UTF-8&autoReconnect=true&autoReconnectForPools=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=picsure

# ---- Internal API ---------------------------------------------------
# Shared secret enforced by InternalTokenFilter on /operations/internal/** -- the gateway's
# query-dispatch calls and the query-service's OperationsClient both present it as
# X-PIC-SURE-INTERNAL-TOKEN. install-dependencies-docker.sh generates one value and writes it
# to both this file and query.env; copy that same value into gateway.env, which the gateway
# deploy job creates separately. Fail-closed: left blank, every /internal/** request is
# rejected (SECRET).
QUERY_SERVICE_INTERNAL_TOKEN=__QUERY_SERVICE_INTERNAL_TOKEN__

# ---- Actuator (off by default in application.yml; enabled here for AIO) ------
# /actuator/** is dark unless PICSURE_ACTUATOR_EXPOSURE is set -- the default 'none' is a
# sentinel that matches no endpoint. Expose health so the deploy smoke check and the gateway's
# downstream health aggregation can reach /operations/actuator/health. Component detail stays
# hidden (DETAILS default 'never'); shallow health/liveness/readiness are open without a token.
# Add prometheus,metrics here when the monitoring rollout lands -- no code change needed.
PICSURE_ACTUATOR_EXPOSURE=health
# PICSURE_ACTUATOR_DETAILS=never
# Set false only for local debugging: it drops the X-Application-Token gate on /actuator/**.
# PICSURE_ACTUATOR_REQUIRE_TOKEN=true
# Shared secret for that gate (SECRET). Blank => protected actuator endpoints 401.
PICSURE_APPLICATION_TOKEN=

# Container port (application.yml default: 8080).
# SERVER_PORT=8080
