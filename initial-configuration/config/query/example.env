# PIC-SURE HPDS Query Service environment (copied/generated to
# $DOCKER_CONFIG_DIR/query/query.env by the "PIC-SURE HPDS Query Service Build and Deploy"
# Jenkins job on first run). Values here are EXAMPLES for a local all-in-one; the deployed
# query.env holds the real secrets and is NOT committed. Env vars set here override
# application.yml defaults.
#
# This service is DB-free: it serves /hpds/{auth,open}[/v3]/query|search and reaches every
# stored query over HTTP through operations-service.

# ---- HPDS backends --------------------------------------------------
# auth  = the non-obfuscated backend; open = the aggregate/obfuscated backend.
# In the all-in-one both point at the same HPDS instance, which requires no bearer token.
HPDS_AUTH_URL=http://hpds:8080/PIC-SURE
HPDS_OPEN_URL=http://hpds:8080/PIC-SURE
HPDS_AUTH_TOKEN=
HPDS_OPEN_TOKEN=

# ---- Operations-service client --------------------------------------
# Base origin only, no path: OperationsClient builds the request path itself, and the gateway
# reuses this same value as its operations route target.
OPERATIONS_SERVICE_URL=http://pic-sure-operations-service:8080
# Shared secret sent as X-PIC-SURE-INTERNAL-TOKEN on every operations-service call, checked by
# that service's InternalTokenFilter. Must be byte-identical here, in gateway.env, and in
# operations.env (SECRET).
QUERY_SERVICE_INTERNAL_TOKEN=REPLACE_WITH_QUERY_SERVICE_INTERNAL_TOKEN

# ---- Aggregate / obfuscation ----------------------------------------
# The visualization service supplies continuous-variable binning. Blank resource id => no
# binning configured (continuous cross-count obfuscation falls back to raw per-value counts).
VISUALIZATION_URL=http://visualization
AGGREGATE_VISUALIZATION_RESOURCE_ID=
AGGREGATE_TARGET_RESOURCE_ID=
# Salt for count obfuscation (SECRET): any random hex string, stable across restarts.
AGGREGATE_OBFUSCATION_SALT=REPLACE_WITH_RANDOM_HEX_SALT
# AGGREGATE_OBFUSCATION_THRESHOLD=10
# AGGREGATE_OBFUSCATION_VARIANCE=3

# ---- Actuator (off by default in application.yml; enabled here for AIO) ------
# /actuator/** is dark unless PICSURE_ACTUATOR_EXPOSURE is set -- the default 'none' is a
# sentinel that matches no endpoint. Expose health so the deploy smoke check and the gateway's
# downstream health aggregation can reach /actuator/health. Component detail stays hidden
# (DETAILS default 'never'); shallow health/liveness/readiness are open without a token.
# Add prometheus,metrics here when the monitoring rollout lands -- no code change needed.
PICSURE_ACTUATOR_EXPOSURE=health
# PICSURE_ACTUATOR_DETAILS=never
# Set false only for local debugging: it drops the X-Application-Token gate on /actuator/**.
# PICSURE_ACTUATOR_REQUIRE_TOKEN=true
# Shared secret for that gate (SECRET). Blank => protected actuator endpoints 401.
PICSURE_APPLICATION_TOKEN=

# Container port (application.yml default: 8080).
# SERVER_PORT=8080
