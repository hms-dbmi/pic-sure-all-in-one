# PIC-SURE HPDS Query Service environment. The installer renders every
# placeholder in the external DOCKER_CONFIG_DIR copy.

# HPDS backends for authenticated and aggregate/open queries.
HPDS_AUTH_URL=http://hpds:8080/PIC-SURE
HPDS_OPEN_URL=http://hpds:8080/PIC-SURE
HPDS_AUTH_TOKEN=
HPDS_OPEN_TOKEN=

CONSENT_BASED_AUTHORIZATION_ENABLED=false

# DB-free persistence through operations-service.
OPERATIONS_SERVICE_URL=http://pic-sure-operations-service:8080
QUERY_SERVICE_INTERNAL_TOKEN=__QUERY_SERVICE_INTERNAL_TOKEN__

# Aggregate query dependencies and stable per-install obfuscation salt.
VISUALIZATION_URL=http://visualization
AGGREGATE_VISUALIZATION_RESOURCE_ID=
AGGREGATE_TARGET_RESOURCE_ID=
AGGREGATE_OBFUSCATION_SALT=__AGGREGATE_OBFUSCATION_SALT__

# Actuator health is required by deployment checks and gateway system status.
PICSURE_ACTUATOR_EXPOSURE=health
PICSURE_APPLICATION_TOKEN=__PICSURE_APPLICATION_TOKEN__
