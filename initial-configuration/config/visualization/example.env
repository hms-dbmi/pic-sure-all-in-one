# PIC-SURE Visualization environment (EXAMPLE). The deployed
# $DOCKER_CONFIG_DIR/visualization/visualization.env is generated by the
# "PIC-SURE Pipeline" Jenkins job on first run (and left untouched if it already
# exists); this template documents the expected keys. Env vars override
# application.properties defaults.

# In AIO the visualization container listens on :80 (gateway routes http://visualization to it).
SERVER_PORT=80

# Single HPDS ingress: pic-sure-hpds-query-service is the ONLY service that talks to HPDS directly.
# Visualization posts /hpds/{auth,open}/v3/query/sync here; that service selects the auth/open backend
# from the path segment and applies the open path's obfuscation. Replaces the former HPDS_BASE_URL
# (and the AUTH_HPDS_RESOURCE_UUID / OPEN_HPDS_RESOURCE_UUID pair, which no longer route anything).
HPDS_QUERY_SERVICE_URL=http://pic-sure-hpds-query-service:8080

# Actuator: off by default in application.properties; enable a shallow /actuator/health here for the
# gateway /system/status probe. Details stay hidden (default never).
PICSURE_ACTUATOR_EXPOSURE=health
